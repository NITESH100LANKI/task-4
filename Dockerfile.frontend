FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create directories for runtime data and models
RUN mkdir -p data/processed models cache embeddings vector_store visualizations dashboards

# Copy code components
COPY frontend/ ./frontend/
COPY configs/ ./configs/
COPY src/ ./src/
COPY utils/ ./utils/
COPY main.py .

# Optionally copy pre-processed data and models if present (e.g. during local build)
# The character group wildcard [t]/[l] prevents the COPY from failing if the files are missing (e.g. in CI)
COPY data/processed/movies.parque[t] ./data/processed/
COPY models/content_recommender.pk[l] ./models/

EXPOSE 8501

CMD ["streamlit", "run", "frontend/app.py", "--server.port", "8501", "--server.address", "0.0.0.0"]
